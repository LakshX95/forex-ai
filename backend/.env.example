# ── API Keys ──────────────────────────────────────────
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/forex_signals

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ────────────────────────────────────────────────
APP_ENV=development
SIGNAL_CACHE_TTL=30        # seconds before signal is recalculated
PRICE_CACHE_TTL=10         # seconds before price is refreshed
